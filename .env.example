# Settings of the server (server/), for `npm run dev` locally: copy to .env (not committed).
# On Netlify the same names are set as environment variables (Site configuration → Environment variables).

# Key of the login cookies, at least 32 characters, e.g. from `openssl rand -base64 32`.
# Changing it logs everybody out.
NUXT_SESSION_PASSWORD=

# The shared password of the group. The QR code (page /qr) contains it, too.
# Changing it logs everybody out and makes old printed QR codes useless.
NUXT_PASTA_PASSWORD=pasta-pesto

# A Hugging Face token with WRITE access to the data repository (https://huggingface.co/settings/tokens),
# best a fine-grained token limited to that one repository.
# Leave empty for local development: the log is then kept in .data/pasta.json.
NUXT_HF_TOKEN=

# The private dataset repository that holds the log
NUXT_HF_REPO=<your-hf-user>/femto-pasta-data
# NUXT_HF_FILE=pasta.json
# NUXT_HF_BRANCH=main
